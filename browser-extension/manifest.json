{
  "manifest_version": 3,
  "name": "ZapTask Quick Capture",
  "version": "1.0.0",
  "description": "Create ZapTask tasks from any page — popup or right-click.",
  "permissions": ["storage", "contextMenus", "activeTab", "notifications"],
  "host_permissions": [
    "https://zaptask.co.uk/*",
    "https://*.zaptask.co.uk/*",
    "http://taskit.test/*",
    "https://taskit.test/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "ZapTask Quick Capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
